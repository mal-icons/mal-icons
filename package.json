{
  "name": "mal-icons-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "A high-performance, multi-framework icon SDK.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git"
  },
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "author": "MALDevs",
  "keywords": [
    "icons",
    "svg",
    "react",
    "vue",
    "svelte",
    "preact",
    "solid",
    "angular",
    "astro",
    "react-native"
  ],
  "workspaces": ["packages/*", "examples/*"],
  "engines": {
    "bun": ">=1.1",
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --build --verbose",
    "test": "bun test",
    "build": "bun run scripts/build.ts && tsc --build --force",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "generate": "bun run packages/cli/src/index.ts generate",
    "size": "bun run scripts/size-check.ts",
    "bench": "bun run scripts/bench.ts",
    "set-version": "bun run scripts/set-version.ts"
  },
  "devDependencies": {
    "@angular/core": "^22.0.0",
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^20.10.2",
    "@types/bun": "^1.3.14",
    "@types/estree": "^1.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vue/server-renderer": "^3.5.35",
    "axe-core": "^4.12.0",
    "eslint": "^10.4.1",
    "preact": "^10.29.2",
    "preact-render-to-string": "^6.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "^0.85.3",
    "react-native-svg": "^15.15.5",
    "solid-js": "^1.9.13",
    "svelte": "^5.56.1",
    "typescript": "^5.7.2",
    "vue": "^3.5.35"
  },
  "overrides": {
    "tar": "^7.5.16",
    "@xmldom/xmldom": "^0.8.12"
  }
}
