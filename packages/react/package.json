{
  "name": "@mal-icons/react",
  "version": "0.5.9",
  "description": "React components and dynamic icon rendering for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/react"
  },
  "keywords": [
    "icons",
    "svg",
    "react",
    "components",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ci": {
      "types": "./dist/icons/ci/index.d.ts",
      "bun": "./src/icons/ci/index.ts",
      "import": "./dist/icons/ci/index.js",
      "require": "./dist/icons/ci/index.cjs"
    },
    "./ci/*": {
      "types": "./dist/icons/ci/*.d.ts",
      "bun": "./src/icons/ci/*.tsx",
      "import": "./dist/icons/ci/*.js"
    },
    "./fi": {
      "types": "./dist/icons/fi/index.d.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./dist/icons/fi/index.js",
      "require": "./dist/icons/fi/index.cjs"
    },
    "./fi/*": {
      "types": "./dist/icons/fi/*.d.ts",
      "bun": "./src/icons/fi/*.tsx",
      "import": "./dist/icons/fi/*.js"
    },
    "./io": {
      "types": "./dist/icons/io/index.d.ts",
      "bun": "./src/icons/io/index.ts",
      "import": "./dist/icons/io/index.js",
      "require": "./dist/icons/io/index.cjs"
    },
    "./io/*": {
      "types": "./dist/icons/io/*.d.ts",
      "bun": "./src/icons/io/*.tsx",
      "import": "./dist/icons/io/*.js"
    },
    "./demo": {
      "types": "./dist/icons/demo/index.d.ts",
      "bun": "./src/icons/demo/index.ts",
      "import": "./dist/icons/demo/index.js",
      "require": "./dist/icons/demo/index.cjs"
    },
    "./demo/*": {
      "types": "./dist/icons/demo/*.d.ts",
      "bun": "./src/icons/demo/*.tsx",
      "import": "./dist/icons/demo/*.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "bun": "./src/server.tsx",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./sprite/ci.svg": "./dist/icons/ci/sprite.svg",
    "./sprite/fi.svg": "./dist/icons/fi/sprite.svg",
    "./sprite/io.svg": "./dist/icons/io/sprite.svg",
    "./manifest.json": "./dist/icons/manifest.json",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
