{
  "name": "@mal-icons/react-native",
  "version": "0.5.9",
  "description": "React Native components for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/react-native"
  },
  "keywords": [
    "icons",
    "svg",
    "react-native",
    "components",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ci": {
      "types": "./dist/icons/ci/index.d.ts",
      "bun": "./src/icons/ci/index.ts",
      "import": "./dist/icons/ci/index.js"
    },
    "./ci/*": {
      "types": "./dist/icons/ci/*.d.ts",
      "bun": "./src/icons/ci/*.tsx",
      "import": "./dist/icons/ci/*.js"
    },
    "./fa": {
      "types": "./dist/icons/fa/index.d.ts",
      "bun": "./src/icons/fa/index.ts",
      "import": "./dist/icons/fa/index.js"
    },
    "./fa/*": {
      "types": "./dist/icons/fa/*.d.ts",
      "bun": "./src/icons/fa/*.tsx",
      "import": "./dist/icons/fa/*.js"
    },
    "./fab": {
      "types": "./dist/icons/fab/index.d.ts",
      "bun": "./src/icons/fab/index.ts",
      "import": "./dist/icons/fab/index.js"
    },
    "./fab/*": {
      "types": "./dist/icons/fab/*.d.ts",
      "bun": "./src/icons/fab/*.tsx",
      "import": "./dist/icons/fab/*.js"
    },
    "./far": {
      "types": "./dist/icons/far/index.d.ts",
      "bun": "./src/icons/far/index.ts",
      "import": "./dist/icons/far/index.js"
    },
    "./far/*": {
      "types": "./dist/icons/far/*.d.ts",
      "bun": "./src/icons/far/*.tsx",
      "import": "./dist/icons/far/*.js"
    },
    "./fi": {
      "types": "./dist/icons/fi/index.d.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./dist/icons/fi/index.js"
    },
    "./fi/*": {
      "types": "./dist/icons/fi/*.d.ts",
      "bun": "./src/icons/fi/*.tsx",
      "import": "./dist/icons/fi/*.js"
    },
    "./io": {
      "types": "./dist/icons/io/index.d.ts",
      "bun": "./src/icons/io/index.ts",
      "import": "./dist/icons/io/index.js"
    },
    "./io/*": {
      "types": "./dist/icons/io/*.d.ts",
      "bun": "./src/icons/io/*.tsx",
      "import": "./dist/icons/io/*.js"
    },
    "./ti": {
      "types": "./dist/icons/ti/index.d.ts",
      "bun": "./src/icons/ti/index.ts",
      "import": "./dist/icons/ti/index.js"
    },
    "./ti/*": {
      "types": "./dist/icons/ti/*.d.ts",
      "bun": "./src/icons/ti/*.tsx",
      "import": "./dist/icons/ti/*.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.70",
    "react-native-svg": ">=13"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
