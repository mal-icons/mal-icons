---
import type { NodeTuple } from "@mal-icons/core";
import IconBase from "../../IconBase.astro";

const nodes: NodeTuple[] = [["polyline",{"fill":"none","stroke":"currentColor","stroke-width":"2","points":"4 16 16 16 16 4","transform":"rotate(180 10 10)"}]];
const defaultAttr = {"fill":"none"};
---

<IconBase viewBox="0 0 24 24" nodes={nodes} defaultAttr={defaultAttr} {...Astro.props} />
