{
  "name": "@mal-icons/angular",
  "version": "0.3.8",
  "description": "Angular standalone components for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "icons",
    "svg",
    "angular",
    "components",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "src"
  ],
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fi": {
      "bun": "./src/icons/fi/index.ts",
      "import": "./src/icons/fi/index.ts"
    },
    "./fi/*": {
      "bun": "./src/icons/fi/*.ts",
      "import": "./src/icons/fi/*.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@angular/core": ">=16"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
