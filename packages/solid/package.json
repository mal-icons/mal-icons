{
  "name": "@mal-icons/solid",
  "version": "0.1.0",
  "description": "SolidJS components for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/solid"
  },
  "keywords": ["icons", "svg", "solid", "solidjs", "components", "mal-icons"],
  "sideEffects": false,
  "files": ["src", "dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fi": {
      "solid": "./src/icons/fi/index.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./src/icons/fi/index.ts"
    },
    "./fi/*": {
      "solid": "./src/icons/fi/*.ts",
      "bun": "./src/icons/fi/*.ts",
      "import": "./src/icons/fi/*.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
