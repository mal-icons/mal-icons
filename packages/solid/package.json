{
  "name": "@mal-icons/solid",
  "version": "0.5.9",
  "description": "SolidJS components for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/solid"
  },
  "keywords": [
    "icons",
    "svg",
    "solid",
    "solidjs",
    "components",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ci": {
      "solid": "./src/icons/ci/index.ts",
      "bun": "./src/icons/ci/index.ts",
      "import": "./src/icons/ci/index.ts"
    },
    "./ci/*": {
      "solid": "./src/icons/ci/*.ts",
      "bun": "./src/icons/ci/*.ts",
      "import": "./src/icons/ci/*.ts"
    },
    "./fa": {
      "solid": "./src/icons/fa/index.ts",
      "bun": "./src/icons/fa/index.ts",
      "import": "./src/icons/fa/index.ts"
    },
    "./fa/*": {
      "solid": "./src/icons/fa/*.ts",
      "bun": "./src/icons/fa/*.ts",
      "import": "./src/icons/fa/*.ts"
    },
    "./fab": {
      "solid": "./src/icons/fab/index.ts",
      "bun": "./src/icons/fab/index.ts",
      "import": "./src/icons/fab/index.ts"
    },
    "./fab/*": {
      "solid": "./src/icons/fab/*.ts",
      "bun": "./src/icons/fab/*.ts",
      "import": "./src/icons/fab/*.ts"
    },
    "./far": {
      "solid": "./src/icons/far/index.ts",
      "bun": "./src/icons/far/index.ts",
      "import": "./src/icons/far/index.ts"
    },
    "./far/*": {
      "solid": "./src/icons/far/*.ts",
      "bun": "./src/icons/far/*.ts",
      "import": "./src/icons/far/*.ts"
    },
    "./fi": {
      "solid": "./src/icons/fi/index.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./src/icons/fi/index.ts"
    },
    "./fi/*": {
      "solid": "./src/icons/fi/*.ts",
      "bun": "./src/icons/fi/*.ts",
      "import": "./src/icons/fi/*.ts"
    },
    "./io": {
      "solid": "./src/icons/io/index.ts",
      "bun": "./src/icons/io/index.ts",
      "import": "./src/icons/io/index.ts"
    },
    "./io/*": {
      "solid": "./src/icons/io/*.ts",
      "bun": "./src/icons/io/*.ts",
      "import": "./src/icons/io/*.ts"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
