{
  "name": "@mal-icons/web",
  "version": "0.1.0",
  "description": "Zero-build web components and icon data for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/web"
  },
  "keywords": ["icons", "svg", "web-components", "custom-elements", "mal-icons"],
  "sideEffects": false,
  "files": ["dist", "src/icons"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fi": {
      "types": "./dist/icons/fi/index.d.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./dist/icons/fi/index.js"
    },
    "./fi/*.json": "./src/icons/fi/*.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
