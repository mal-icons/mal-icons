{
  "name": "@mal-icon/web",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "src/icons"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fi": {
      "types": "./dist/icons/fi/index.d.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./dist/icons/fi/index.js"
    },
    "./fi/*.json": "./src/icons/fi/*.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mal-icon/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
