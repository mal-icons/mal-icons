{
  "name": "@mal-icons/svelte",
  "version": "0.4.8",
  "description": "Svelte components for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/svelte"
  },
  "keywords": [
    "icons",
    "svg",
    "svelte",
    "components",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "src",
    "dist"
  ],
  "svelte": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./fi": {
      "svelte": "./src/icons/fi/index.ts",
      "bun": "./src/icons/fi/index.ts",
      "import": "./src/icons/fi/index.ts"
    },
    "./fi/*": {
      "svelte": "./src/icons/fi/*.svelte",
      "bun": "./src/icons/fi/*.svelte",
      "import": "./src/icons/fi/*.svelte"
    },
    "./IconBase.svelte": "./src/IconBase.svelte",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "dependencies": {
    "@mal-icons/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
