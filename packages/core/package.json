{
  "name": "@mal-icons/core",
  "version": "0.7.11",
  "description": "Framework-agnostic types and theming utilities for mal-icons.",
  "type": "module",
  "license": "MIT",
  "author": "MALDevs",
  "homepage": "https://github.com/mal-icons/mal-icons#readme",
  "bugs": {
    "url": "https://github.com/mal-icons/mal-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mal-icons/mal-icons.git",
    "directory": "packages/core"
  },
  "keywords": [
    "icons",
    "svg",
    "typescript",
    "theming",
    "mal-icons"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
